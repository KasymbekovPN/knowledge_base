{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C++23",
            "type": "shell",
            "command": "C:/Program Files/LLVM/bin/clang++.exe",
            "args": [
                "-std=c++23",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}